DATABASE_URL=postgresql://ftp_admin:password@localhost:5432/finetuning
AWS_REGION=us-east-1
PROJECT_PREFIX=ftp-prod

# URL that training EC2 instances use to reach the API
# Must be reachable from within the VPC (private IP or internal DNS)
API_INTERNAL_URL=http://api.internal:8000

POLL_INTERVAL_SECONDS=10
WATCHDOG_INTERVAL_SECONDS=60
HEARTBEAT_TIMEOUT_MINUTES=10
# Cloud: EC2 G/VT vCPU quota and one user's share of it while others wait
VCPU_QUOTA=64
USER_VCPU_SHARE=0.5
# Local mode only: jobs at once (defaults to 1)
# MAX_CONCURRENT_JOBS=1
